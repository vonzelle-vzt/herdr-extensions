#!/usr/bin/env bash
# Blame panel — git log --follow plus git show --stat for the ACTIVE file, plus a blame of the
# active line so the panel is genuinely about the file/line SpiceEdit has open, not just the repo.
#
# Launched as a [[panes]] command by open-panel.sh (action open-blame). Degrades gracefully: no
# active file published yet (or SpiceEdit's upstream contract not merged) just says so.
set -uo pipefail

GIT=/usr/bin/git
PY=/usr/bin/python3
STTY=/bin/stty
AWK=/usr/bin/awk
ACTIVE_JSON="${XDG_STATE_HOME:-$HOME/.local/state}/spiceedit/active.json"

# term_width -- the pane's current column count, re-read on every redraw so a SIGWINCH picks up
# the new size rather than the one the panel opened at. Falls back to 80 when it cannot be
# determined (a piped, non-tty invocation, as in the test suite, or no $TERM at all).
term_width() {
  # stty size (not tput cols) -- tput queries window size via its OWN stdout, which a bash
  # command substitution redirects to a pipe, so tput silently falls back to the terminfo
  # default (80) instead of the pty's real size. stty size reads via its STDIN, which is not
  # redirected here, so it sees the real window even when captured with $(...).
  local w
  w="$("$STTY" size 2>/dev/null | "$AWK" '{print $2}')"
  case "$w" in
    ''|*[!0-9]*|0) w=80 ;;
  esac
  printf '%s' "$w"
}

# hr <width> -- a horizontal rule exactly <width> columns wide, so the header visibly reflows.
hr() {
  printf '%*s\n' "$1" '' | tr ' ' '-'
}

# trunc_width <width> -- clip each line of stdin to at most <width> columns, so a panel that was
# drawn wide and then squeezed narrower does not leave stale-width lines wrapping into each other.
trunc_width() {
  "$PY" -c '
import sys
w = int(sys.argv[1])
for line in sys.stdin:
    line = line.rstrip("\n")
    if len(line) > w:
        line = line[: max(w - 1, 0)] + "…"
    print(line)
' "$1"
}

# NOTE the separator is \x1f (unit separator), NOT a tab. Tab counts as IFS WHITESPACE, so
# bash collapses runs of it and strips leading/trailing fields — with no file open the
# payload starts with an empty field and every value silently shifts left, putting the line
# number into the filename variable. \x1f is non-whitespace, so empty fields are preserved.
IFS=$'\x1f' read -r active_file active_line active_col active_root <<<"$("$PY" - "$ACTIVE_JSON" <<'EOF'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
print("\x1f".join([d.get("file") or "", str(d.get("line") or 1), str(d.get("col") or 1),
                 d.get("root") or ""]))
EOF
)"

render() {
  # The header names the active file and must NEVER be clipped by width truncation -- a long path
  # is exactly the case where losing the tail of it matters most. Only the body (the part
  # truncation actually exists for) goes through trunc_width; the header line is printed straight.
  local w="$1" dir

  if [ -z "$active_file" ] || [ ! -f "$active_file" ]; then
    echo "No active file — SpiceEdit has not published one yet, or none is open."
    echo "Open a file in the editor, then reopen this panel."
    return
  fi

  dir="$(cd "$(dirname "$active_file")" && pwd)"
  if ! "$GIT" -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "$active_file is not inside a git repository."
    return
  fi

  echo "Blame — $active_file"
  hr "$w"

  {
    local commit
    echo
    echo "---- git log --follow (last 20) ----"
    "$GIT" -C "$dir" log --follow --oneline -n 20 -- "$active_file"

    echo
    echo "---- most recent commit touching this file ----"
    commit="$("$GIT" -C "$dir" log -n 1 --format=%H -- "$active_file" 2>/dev/null)"
    if [ -n "$commit" ]; then
      "$GIT" -C "$dir" show --stat --no-color "$commit"
    else
      echo "(no commits touch this file yet)"
    fi

    echo
    echo "---- blame at line $active_line ----"
    "$GIT" -C "$dir" blame -L "$active_line","$active_line" --date=short -- "$active_file" 2>/dev/null \
      || echo "(blame failed for that line)"
  } | trunc_width "$w"
}

redraw() {
  local w
  w="$(term_width)"
  render "$w"
  echo
  echo "Press any key to close..."
}
trap redraw WINCH
redraw

while :; do
  IFS= read -r -n1 -s _
  rc=$?
  [ "$rc" -gt 128 ] && continue
  break
done
