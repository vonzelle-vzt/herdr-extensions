#!/usr/bin/env bash
# Markdown panel — `glow -s dark` on the ACTIVE file.
#
# Launched as a [[panes]] command by open-panel.sh (action open-markdown). Absolute path to glow
# is mandatory (herdr execs pane commands under launchd's minimal PATH). Degrades to a raw `cat`
# if glow is not installed, and to a message if there is no active file at all.
set -uo pipefail

PY=/usr/bin/python3
STTY=/bin/stty
AWK=/usr/bin/awk
ACTIVE_JSON="${XDG_STATE_HOME:-$HOME/.local/state}/spiceedit/active.json"

# term_width -- the pane's current column count, re-read on every redraw so a SIGWINCH picks up
# the new size rather than the one the panel opened at. Falls back to 80 when it cannot be
# determined (a piped, non-tty invocation, as in the test suite, or no $TERM at all). glow itself
# is width-aware via -w, so this is the one panel that hands its width straight to the renderer
# instead of clipping the already-rendered output afterwards.
term_width() {
  # stty size (not tput cols) -- tput queries window size via its OWN stdout, which a bash
  # command substitution redirects to a pipe, so tput silently falls back to the terminfo
  # default (80) instead of the pty's real size. stty size reads via its STDIN, which is not
  # redirected here, so it sees the real window even when captured with $(...).
  local w
  w="$("$STTY" size 2>/dev/null | "$AWK" '{print $2}')"
  case "$w" in
    ''|*[!0-9]*|0) w=80 ;;
  esac
  printf '%s' "$w"
}

# hr <width> -- a horizontal rule exactly <width> columns wide, so the header visibly reflows.
hr() {
  printf '%*s\n' "$1" '' | tr ' ' '-'
}

# NOTE the separator is \x1f (unit separator), NOT a tab. Tab counts as IFS WHITESPACE, so
# bash collapses runs of it and strips leading/trailing fields — with no file open the
# payload starts with an empty field and every value silently shifts left, putting the line
# number into the filename variable. \x1f is non-whitespace, so empty fields are preserved.
IFS=$'\x1f' read -r active_file active_line active_col active_root <<<"$("$PY" - "$ACTIVE_JSON" <<'EOF'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
print("\x1f".join([d.get("file") or "", str(d.get("line") or 1), str(d.get("col") or 1),
                 d.get("root") or ""]))
EOF
)"

GLOW=""
for d in /opt/homebrew/bin /usr/local/bin; do
  if [ -x "$d/glow" ]; then
    GLOW="$d/glow"
    break
  fi
done

render() {
  local w="$1"

  if [ -z "$active_file" ] || [ ! -f "$active_file" ]; then
    echo "No active file — SpiceEdit has not published one yet, or none is open."
    echo "Open a Markdown file in the editor, then reopen this panel."
    return
  fi

  echo "Markdown — $active_file"
  hr "$w"

  case "$active_file" in
    *.md|*.mdx|*.markdown) : ;;
    *) echo "Active file is not Markdown: $active_file (showing it anyway)"; echo ;;
  esac

  if [ -n "$GLOW" ]; then
    "$GLOW" -s dark -w "$w" "$active_file"
  else
    echo "glow not found in /opt/homebrew/bin or /usr/local/bin — showing the raw file instead."
    echo
    cat -- "$active_file"
  fi
}

redraw() {
  local w
  w="$(term_width)"
  render "$w"
  echo
  echo "Press any key to close..."
}
trap redraw WINCH
redraw

while :; do
  IFS= read -r -n1 -s _
  rc=$?
  [ "$rc" -gt 128 ] && continue
  break
done
