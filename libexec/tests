#!/usr/bin/env bash
# Tests panel — detects vitest/jest (from package.json) or pytest (from pyproject.toml/pytest.ini/
# setup.cfg) and runs it for the repo.
#
# Launched as a [[panes]] command by open-panel.sh (action open-tests). Absolute paths throughout:
# herdr execs pane commands under launchd's minimal PATH, which has neither /opt/homebrew/bin nor
# a vendored node_modules/.bin on it.
set -uo pipefail

GIT=/usr/bin/git
PY=/usr/bin/python3
STTY=/bin/stty
AWK=/usr/bin/awk
ACTIVE_JSON="${XDG_STATE_HOME:-$HOME/.local/state}/spiceedit/active.json"

# term_width -- the pane's current column count, re-read on every redraw so a SIGWINCH picks up
# the new size rather than the one the panel opened at. Falls back to 80 when it cannot be
# determined (a piped, non-tty invocation, as in the test suite, or no $TERM at all).
term_width() {
  # stty size (not tput cols) -- tput queries window size via its OWN stdout, which a bash
  # command substitution redirects to a pipe, so tput silently falls back to the terminfo
  # default (80) instead of the pty's real size. stty size reads via its STDIN, which is not
  # redirected here, so it sees the real window even when captured with $(...).
  local w
  w="$("$STTY" size 2>/dev/null | "$AWK" '{print $2}')"
  case "$w" in
    ''|*[!0-9]*|0) w=80 ;;
  esac
  printf '%s' "$w"
}

# hr <width> -- a horizontal rule exactly <width> columns wide, so the header visibly reflows.
hr() {
  printf '%*s\n' "$1" '' | tr ' ' '-'
}

# trunc_width <width> -- clip each line of stdin to at most <width> columns, so a panel that was
# drawn wide and then squeezed narrower does not leave stale-width lines wrapping into each other.
trunc_width() {
  "$PY" -c '
import sys
w = int(sys.argv[1])
for line in sys.stdin:
    line = line.rstrip("\n")
    if len(line) > w:
        line = line[: max(w - 1, 0)] + "…"
    print(line)
' "$1"
}

# NOTE the separator is \x1f (unit separator), NOT a tab. Tab counts as IFS WHITESPACE, so
# bash collapses runs of it and strips leading/trailing fields — with no file open the
# payload starts with an empty field and every value silently shifts left, putting the line
# number into the filename variable. \x1f is non-whitespace, so empty fields are preserved.
IFS=$'\x1f' read -r active_file active_line active_col active_root <<<"$("$PY" - "$ACTIVE_JSON" <<'EOF'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
print("\x1f".join([d.get("file") or "", str(d.get("line") or 1), str(d.get("col") or 1),
                 d.get("root") or ""]))
EOF
)"

repo="$active_root"
if [ -z "$repo" ] || [ ! -d "$repo" ]; then
  base="${active_file:-$PWD}"
  dir="$(cd "$(dirname "$base")" 2>/dev/null && pwd)" || dir="$PWD"
  repo="$("$GIT" -C "$dir" rev-parse --show-toplevel 2>/dev/null)"
  [ -n "$repo" ] || repo="$dir"
fi

find_node_bin() {   # find_node_bin <name>  -- walk up from $repo for a vendored node_modules/.bin
  local dir="$repo" name="$1"
  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    if [ -x "$dir/node_modules/.bin/$name" ]; then
      printf '%s' "$dir/node_modules/.bin/$name"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

find_abs() {   # find_abs <name>  -- common absolute install locations
  local name="$1" d
  for d in /opt/homebrew/bin /usr/local/bin /usr/bin /bin; do
    if [ -x "$d/$name" ]; then
      printf '%s' "$d/$name"
      return 0
    fi
  done
  return 1
}

# Run the whole test suite ONCE, up front, and capture its output: SIGWINCH should reflow the
# display at the new width, never re-run vitest/jest/pytest for every resize the user does while
# reading the results.
ran=0
runner_output=""

if [ -f "$repo/package.json" ]; then
  pkg="$(cat "$repo/package.json" 2>/dev/null)"
  runner=""
  case "$pkg" in
    *'"vitest"'*) runner=vitest ;;
    *'"jest"'*) runner=jest ;;
  esac
  if [ -n "$runner" ]; then
    bin="$(find_node_bin "$runner" || true)"
    if [ -n "$bin" ]; then
      case "$runner" in
        vitest) out="$( cd "$repo" && "$bin" run 2>&1 )" ;;
        jest)   out="$( cd "$repo" && "$bin" 2>&1 )" ;;
      esac
      runner_output="$runner_output== $runner ==
$out
"
      ran=1
    else
      runner_output="$runner_output$runner is referenced in package.json but not vendored in node_modules/.bin
(run npm/pnpm/yarn install first)
"
    fi
  fi
fi

if [ -f "$repo/pyproject.toml" ] || [ -f "$repo/pytest.ini" ] || [ -f "$repo/setup.cfg" ]; then
  py_bin="$(find_abs pytest || true)"
  if [ -z "$py_bin" ] && [ -x "$repo/.venv/bin/pytest" ]; then
    py_bin="$repo/.venv/bin/pytest"
  fi
  if [ -n "$py_bin" ]; then
    out="$( cd "$repo" && "$py_bin" -q 2>&1 )"
    runner_output="$runner_output== pytest ==
$out
"
    ran=1
  else
    runner_output="${runner_output}pytest config found but no pytest binary in .venv/bin or the usual absolute locations
"
  fi
fi

if [ "$ran" = "0" ] && [ -z "$runner_output" ]; then
  runner_output="No recognized test runner (vitest/jest/pytest) detected for this repo."
fi

render() {
  # The header names the repo and must NEVER be clipped by width truncation -- a long checkout
  # path is exactly the case where losing the tail of it matters most. Only the body (the part
  # truncation actually exists for) goes through trunc_width; the header line is printed straight.
  local w="$1"
  echo "Tests — $repo"
  hr "$w"
  { echo; printf '%s\n' "$runner_output"; } | trunc_width "$w"
}

redraw() {
  local w
  w="$(term_width)"
  render "$w"
  echo
  echo "Press any key to close..."
}
trap redraw WINCH
redraw

while :; do
  IFS= read -r -n1 -s _
  rc=$?
  [ "$rc" -gt 128 ] && continue
  break
done
