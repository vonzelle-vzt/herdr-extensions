#!/usr/bin/env bash
# Problems panel — runs tsc/eslint/ruff for the current repo (whichever are available and
# configured) and prints their diagnostics grouped by file, file:line:col first.
#
# Launched as a [[panes]] command by open-panel.sh (see plugin/herdr-plugin.toml, action
# open-problems). Reads the ACTIVE FILE CONTRACT only to find the repo root; the panel itself is
# repo-scoped, not file-scoped. Absolute paths throughout: herdr execs pane commands under
# launchd's minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin), which has neither /opt/homebrew/bin nor
# a vendored node_modules/.bin on it.
set -uo pipefail

GIT=/usr/bin/git
PY=/usr/bin/python3
STTY=/bin/stty
AWK=/usr/bin/awk
ACTIVE_JSON="${XDG_STATE_HOME:-$HOME/.local/state}/spiceedit/active.json"

# Same stable path libexec/preview writes to. Its mtime is the freshness signal: a preview panel
# nobody has open should not make this panel shout about a page that is not being looked at.
CONSOLE_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-extensions/preview-console.log"
CONSOLE_LOG_MAX_AGE="${HERDR_PREVIEW_LOG_MAX_AGE:-120}"

# term_width -- the pane's current column count, re-read on every redraw so a SIGWINCH picks up
# the new size rather than the one the panel opened at. Falls back to 80 when it cannot be
# determined (a piped, non-tty invocation, as in the test suite, or no $TERM at all).
term_width() {
  # stty size (not tput cols) -- tput queries window size via its OWN stdout, which a bash
  # command substitution redirects to a pipe, so tput silently falls back to the terminfo
  # default (80) instead of the pty's real size. stty size reads via its STDIN, which is not
  # redirected here, so it sees the real window even when captured with $(...).
  local w
  w="$("$STTY" size 2>/dev/null | "$AWK" '{print $2}')"
  case "$w" in
    ''|*[!0-9]*|0) w=80 ;;
  esac
  printf '%s' "$w"
}

# hr <width> -- a horizontal rule exactly <width> columns wide, so the header visibly reflows.
hr() {
  printf '%*s\n' "$1" '' | tr ' ' '-'
}

# trunc_width <width> -- clip each line of stdin to at most <width> columns, so a panel that was
# drawn wide and then squeezed narrower does not leave stale-width lines wrapping into each other.
trunc_width() {
  "$PY" -c '
import sys
w = int(sys.argv[1])
for line in sys.stdin:
    line = line.rstrip("\n")
    if len(line) > w:
        line = line[: max(w - 1, 0)] + "…"
    print(line)
' "$1"
}

# NOTE the separator is \x1f (unit separator), NOT a tab. Tab counts as IFS WHITESPACE, so
# bash collapses runs of it and strips leading/trailing fields — with no file open the
# payload starts with an empty field and every value silently shifts left, putting the line
# number into the filename variable. \x1f is non-whitespace, so empty fields are preserved.
IFS=$'\x1f' read -r active_file active_line active_col active_root <<<"$("$PY" - "$ACTIVE_JSON" <<'EOF'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
print("\x1f".join([d.get("file") or "", str(d.get("line") or 1), str(d.get("col") or 1),
                 d.get("root") or ""]))
EOF
)"

repo="$active_root"
if [ -z "$repo" ] || [ ! -d "$repo" ]; then
  base="${active_file:-$PWD}"
  dir="$(cd "$(dirname "$base")" 2>/dev/null && pwd)" || dir="$PWD"
  repo="$("$GIT" -C "$dir" rev-parse --show-toplevel 2>/dev/null)"
  [ -n "$repo" ] || repo="$dir"
fi

find_node_bin() {   # find_node_bin <name>  -- walk up from $repo for a vendored node_modules/.bin
  local dir="$repo" name="$1"
  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    if [ -x "$dir/node_modules/.bin/$name" ]; then
      printf '%s' "$dir/node_modules/.bin/$name"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

find_abs() {   # find_abs <name>  -- common absolute install locations, launchd PATH has none of them
  local name="$1" d
  for d in /opt/homebrew/bin /usr/local/bin /usr/bin /bin; do
    if [ -x "$d/$name" ]; then
      printf '%s' "$d/$name"
      return 0
    fi
  done
  return 1
}

# Gather diagnostics ONCE, up front, not on every redraw: SIGWINCH should reflow the display, not
# re-invoke tsc/eslint/ruff for every resize the user does while reading the output.
tsc_out=""
tsc_missing_msg=""
if [ -f "$repo/tsconfig.json" ]; then
  tsc_bin="$(find_node_bin tsc || true)"
  if [ -n "$tsc_bin" ]; then
    tsc_out="$("$tsc_bin" --noEmit --pretty false -p "$repo" 2>&1 || true)"
  else
    tsc_missing_msg="tsc: tsconfig.json present but no vendored tsc in node_modules/.bin (run npm/pnpm/yarn install)"
  fi
fi

eslint_json=""
eslint_bin="$(find_node_bin eslint || true)"
if [ -n "$eslint_bin" ]; then
  eslint_json="$("$eslint_bin" "$repo" --format json 2>/dev/null || true)"
fi

ruff_json=""
ruff_bin="$(find_abs ruff || true)"
if [ -z "$ruff_bin" ] && [ -x "$repo/.venv/bin/ruff" ]; then
  ruff_bin="$repo/.venv/bin/ruff"
fi
if [ -n "$ruff_bin" ] && { [ -f "$repo/pyproject.toml" ] || [ -f "$repo/ruff.toml" ] || [ -f "$repo/.ruff.toml" ]; }; then
  ruff_json="$("$ruff_bin" check "$repo" --output-format json 2>/dev/null || true)"
fi

render() {
  # The header names the repo and must NEVER be clipped by width truncation -- a long checkout
  # path is exactly the case where losing the tail of it matters most. Only the body (the part
  # truncation actually exists for) goes through trunc_width; the header line is printed straight.
  local w="$1"
  echo "Problems — $repo"
  hr "$w"
  render_body "$w" | trunc_width "$w"
}

render_body() {
  echo

  [ -n "$tsc_missing_msg" ] && echo "$tsc_missing_msg"

  "$PY" - "$tsc_out" "$eslint_json" "$ruff_json" <<'EOF'
import json, re, sys

tsc_out, eslint_json, ruff_json = sys.argv[1:4]
items = []  # (file, line, col, message, tool)

for line in tsc_out.splitlines():
    m = re.match(r"^(.+?)\((\d+),(\d+)\): (.+)$", line)
    if m:
        items.append((m.group(1), int(m.group(2)), int(m.group(3)), m.group(4), "tsc"))

if eslint_json.strip():
    try:
        for f in json.loads(eslint_json):
            for msg in f.get("messages", []):
                items.append((f.get("filePath", ""), msg.get("line", 0), msg.get("column", 0),
                              msg.get("message", ""), "eslint"))
    except Exception:
        pass

if ruff_json.strip():
    try:
        for d in json.loads(ruff_json):
            loc = d.get("location", {})
            items.append((d.get("filename", ""), loc.get("row", 0), loc.get("column", 0),
                          d.get("message", ""), "ruff"))
    except Exception:
        pass

if not items:
    print("No problems found (or no configured linter/tsc is available for this repo).")
else:
    by_file = {}
    for it in items:
        by_file.setdefault(it[0], []).append(it)
    for f in sorted(by_file):
        print(f)
        for _f, ln, col, msg, tool in sorted(by_file[f], key=lambda x: (x[1], x[2])):
            print("  %d:%d  [%s]  %s" % (ln, col, tool, msg))
    print()
    print("%d problem(s) across %d file(s)" % (len(items), len(by_file)))
EOF

  # ---- runtime diagnostics, from the Preview panel's console log -----------------------------
  # Absence is not an error: no log, or a stale one, means nobody has the Preview panel open right
  # now, and a panel that shouts about a preview nobody opened is noise -- print nothing extra.
  "$PY" - "$CONSOLE_LOG" "$CONSOLE_LOG_MAX_AGE" "$repo" <<'EOF'
import os
import sys
import time

log_path, max_age_raw, repo = sys.argv[1:4]
try:
    max_age = float(max_age_raw)
except ValueError:
    max_age = 120.0

try:
    mtime = os.path.getmtime(log_path)
except OSError:
    sys.exit(0)  # missing: silent

if (time.time() - mtime) > max_age:
    sys.exit(0)  # stale: silent

try:
    with open(log_path, errors="replace") as f:
        raw_lines = [l for l in f.read().split("\n") if l]
except OSError:
    raw_lines = []

records = []
for line in raw_lines:
    parts = line.split("\x1f")
    if len(parts) != 3:
        continue
    url, lineno, msg = parts
    records.append((url, lineno, msg))

if not records:
    sys.exit(0)  # a live preview with nothing to report: also silent


def map_path(url):
    # Strip scheme://host[:port] and treat the remainder as repo-relative; only report the
    # rewritten path if it actually resolves to a file, otherwise fall back to the raw URL.
    m = re_match(url)
    rest = (m.group(1) or "/") if m else url
    rest = rest.lstrip("/")
    if not rest:
        return None
    candidate = os.path.join(repo, rest)
    if os.path.isfile(candidate):
        return os.path.relpath(candidate, repo)
    return None


def re_match(url):
    import re
    return re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*://[^/]+(/.*)?$", url)


by_loc = {}
for url, lineno, msg in records:
    loc = map_path(url) or url
    by_loc.setdefault(loc, []).append((lineno, msg))

print()
print("-- Runtime (Preview) --")
for loc in sorted(by_loc):
    print(loc)
    for lineno, msg in sorted(by_loc[loc], key=lambda x: int(x[0]) if x[0].isdigit() else 0):
        print("  %s:1  [runtime]  %s" % (lineno, msg))
print()
print("%d runtime problem(s) across %d location(s)" % (len(records), len(by_loc)))
EOF
}

redraw() {
  local w
  w="$(term_width)"
  render "$w"
  echo
  echo "Press any key to close..."
}
trap redraw WINCH
redraw

while :; do
  IFS= read -r -n1 -s _
  rc=$?
  [ "$rc" -gt 128 ] && continue
  break
done
