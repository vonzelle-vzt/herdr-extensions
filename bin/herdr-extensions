#!/usr/bin/env python3
"""herdr-extensions — make herdr behave like a tiny VS Code.

    herdr-extensions install [--dry-run] [--no-deps] [--projects-root DIR]
    herdr-extensions uninstall [--purge]
    herdr-extensions doctor
    herdr-extensions version

Stdlib only, and deliberately targets Python 3.9 — that is what ships on macOS, so there is no
tomllib here. Config edits are marker-delimited text injections rather than TOML round-trips, which
also means a user's own keys, comments, and settings survive install AND uninstall untouched.

See SPEC.md for why each step is the way it is; every non-obvious choice is a silent failure this
avoids (launchd PATH, event-vs-focus races, disallowUnknownFields, ...).
"""

import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys

VERSION = "0.10.0"

HOME = os.path.expanduser("~")
# realpath, NOT abspath. Both documented install paths put a SYMLINK on PATH -- install.sh does
# `ln -sf` into ~/.local/bin, and the Homebrew formula symlinks from libexec -- and abspath does
# not follow symlinks, so REPO resolved to the symlink's own directory. Every command that needs a
# package file then died with 'package file missing: <that dir>/plugin/herdr-plugin.toml'. Only
# running ./bin/herdr-extensions from a checkout ever worked.
REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

PLUGIN_ID = "herdr-extensions"
HERDR_CFG_DIR = os.path.join(HOME, ".config", "herdr")
HERDR_CFG = os.path.join(HERDR_CFG_DIR, "config.toml")
PLUGIN_DST = os.path.join(HERDR_CFG_DIR, "plugins", "local", PLUGIN_ID)
SPICE_CFG_DIR = os.path.join(HOME, ".config", "spiceedit")
BIN_DIR = os.path.join(HOME, ".local", "bin")

BEGIN = "# >>> herdr-extensions (managed) >>>"
END = "# <<< herdr-extensions (managed) <<<"

# Skin blocks are a SEPARATE managed region from the keybinding block above — distinct markers so
# `skin reset` can never touch a keybinding, and `uninstall` can never touch a skin. See
# apply_skin()/reset_skin() for why this is actually TWO spliced regions, not one.
SKIN_BEGIN = "# >>> herdr-extensions skin >>>"
SKIN_END = "# <<< herdr-extensions skin <<<"
SKIN_UI_BEGIN = "# >>> herdr-extensions skin (ui) >>>"
SKIN_UI_END = "# <<< herdr-extensions skin (ui) <<<"

# Panel scripts shipped in libexec/ that get copied alongside open-panel.sh into the rendered
# plugin directory (see render_plugin()) and wired up as [[panes]] + [[actions]] in the manifest.
PANEL_SCRIPTS = ["problems", "search", "todo", "blame", "markdown", "tests", "debug", "preview", "review"]

# Keybindings we inject: (key, action id, human description).
#
# 🔴 EVERY KEY HERE MUST BE CHECKED AGAINST HERDR'S OWN DEFAULTS FIRST. `herdr --default-config`
# reserves 39 prefix bindings on 0.7.5, and a [[keys.command]] entry silently WINS over the built-in — no
# warning, no log line, the built-in simply stops working. v0.1.0 of this package shipped three
# such collisions and destroyed `edit_scrollback` (prefix+e), `goto` (prefix+g — the fuzzy
# space/tab/agent picker) and `resize_mode` (prefix+r) on every machine that installed it.
#
# So the mapping below is chosen for VS Code muscle memory *within* the keys herdr leaves free,
# and `doctor --keymap` re-derives the reserved set from the installed binary at runtime rather
# than trusting this comment to stay true across herdr releases.
#
# Deliberately few direct keys: everything else hangs off one command palette, which is what VS
# Code itself does, and it keeps us from eating a dozen of the user's bindings.
KEYS = [
    ("prefix+shift+e", "open-editor", "editor panel, left of the current pane (VS Code shift+cmd+E)"),
    ("prefix+shift+o", "open-editor-tab", "editor full-width in its own tab"),
    ("prefix+shift+s", "open-git", "lazygit source-control panel, below the current pane"),
    ("prefix+shift+m", "open-problems", "Problems panel: tsc/eslint/ruff, below (VS Code shift+cmd+M)"),
    ("prefix+shift+f", "open-search", "Search panel: ripgrep across the repo, below (VS Code shift+cmd+F)"),
    ("prefix+t", "open-todo", "TODO/FIXME/HACK/XXX panel, below"),
    ("prefix+shift+b", "open-blame", "Blame panel for the active file, below"),
    ("prefix+shift+v", "open-markdown", "Markdown preview (glow) of the active file, below (VS Code shift+cmd+V)"),
    ("prefix+d", "open-debug", "Debug panel: launch configs + adapter handoff (VS Code ctrl+shift+D)"),
    ("prefix+shift+u", "open-tests", "Tests panel: vitest/jest/pytest, below"),
    # herdr has no mouse divider drag and only a modal resize (prefix+r), so give the divider a
    # one-keypress nudge. shift+h/shift+l mirror herdr's own h/l pane-navigation direction.
    # Images: stage the clipboard image (or newest screenshot) and type its path to the agent.
    ("prefix+shift+a", "open-preview", "Preview panel: render the dev server (app) in a pane"),
    ("prefix+i", "paste-image", "paste an image/screenshot path to the agent"),
    # prefix+shift+c is free against herdr's 39 reserved bindings; prefix+r and prefix+shift+r are
    # BOTH taken (prefix+r is herdr's only resize binding) so neither was an option here.
    ("prefix+shift+k", "open-review", "Review panel: comment on the agent's diff and send it back"),
    ("prefix+shift+l", "resize-wider", "move the split divider right one step"),
    ("prefix+shift+h", "resize-narrower", "move the split divider left one step"),
]

# ---------------------------------------------------------------------------------------------
# output helpers
# ---------------------------------------------------------------------------------------------

_TTY = sys.stdout.isatty()


def _c(code, s):
    return "\033[%sm%s\033[0m" % (code, s) if _TTY else s


def ok(m):
    print("  %s %s" % (_c("32", "OK  "), m))


def warn(m):
    print("  %s %s" % (_c("33", "WARN"), m))


def bad(m):
    print("  %s %s" % (_c("31", "FAIL"), m))


def act(m):
    print("  %s %s" % (_c("36", "->  "), m))


def head(m):
    print("\n%s" % _c("1", m))


def die(m):
    print("%s %s" % (_c("31", "error:"), m), file=sys.stderr)
    raise SystemExit(1)


def run(cmd, check=False, capture_bytes=False):
    """Run a command, returning (rc, stdout+stderr). Never raises unless check.

    capture_bytes returns raw bytes and keeps stderr OFF stdout — required when the output is a
    binary plist (`defaults export`), where decoding to text or interleaving stderr corrupts it.
    """
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL if capture_bytes else subprocess.STDOUT)
        out = p.stdout if capture_bytes else p.stdout.decode("utf-8", "replace")
        if check and p.returncode != 0:
            die("command failed: %s\n%s" % (" ".join(cmd), out))
        return p.returncode, out
    except FileNotFoundError:
        return 127, (b"" if capture_bytes else "")


# ---------------------------------------------------------------------------------------------
# discovery
# ---------------------------------------------------------------------------------------------


def which(name):
    """Absolute path for a binary, searching PATH plus the usual Homebrew prefixes.

    Explicitly checks brew prefixes because the herdr SERVER runs under launchd's minimal PATH; we
    must record an absolute path in the manifest, and the installing shell's PATH is not a reliable
    guide to what exists on the machine.

    Deliberately does NOT resolve symlinks: Homebrew's /opt/homebrew/bin/<name> is a stable
    symlink into a versioned Cellar path, and brew re-points it on upgrade. Recording the resolved
    target instead would pin the manifest to e.g. spice-edit/0.0.43 and break every pane command
    the next time the user runs `brew upgrade`.
    """
    p = shutil.which(name)
    if p:
        return p if os.path.isabs(p) else os.path.abspath(p)
    for pre in ("/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin"):
        cand = os.path.join(pre, name)
        if os.access(cand, os.X_OK):
            return cand
    return None


def herdr_bin():
    return which("herdr")


# The editor binary, preferring our fork.
#
# herdr-edit is cloudmanic/spice-edit plus the things a VS Code user notices missing: LSP
# diagnostics, a file tree that respects .gitignore, find AND replace, auto-closing pairs, a start
# page instead of "No file open", a layout that degrades in a narrow pane instead of refusing to
# draw, and the active-file publishing every panel in this package reads.
#
# Upstream `spiceedit` still works and is the documented fallback — the panels degrade to the repo
# root without active.json, and everything except diagnostics behaves the same. Preferring the fork
# rather than requiring it means neither install is broken by the other.
EDITOR_CANDIDATES = ("herdr-edit", "spiceedit")


def editor_bin():
    for name in EDITOR_CANDIDATES:
        p = which(name)
        if p:
            return p
    return None


def editor_is_fork():
    return which("herdr-edit") is not None


def herdr_version():
    h = herdr_bin()
    if not h:
        return None
    rc, out = run([h, "--version"])
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", out)
    return tuple(int(x) for x in m.groups()) if m else None


# ---------------------------------------------------------------------------------------------
# keymap collision detection
#
# A [[keys.command]] entry silently OVERRIDES a herdr built-in: no warning, no log line, the
# built-in just stops responding. That is the worst possible failure mode for an extension —
# the user blames herdr, not us. So we refuse to install over a conflict.
#
# The reserved set is re-derived from the INSTALLED BINARY on every run rather than hardcoded,
# because herdr keeps adding actions (0.6.3 introduced `goto = "prefix+g"`), and a table frozen
# into this file would go stale precisely when it matters most.
# ---------------------------------------------------------------------------------------------


def _expand(key):
    """`prefix+1..9` is one config entry but nine bindings. Expand so ranges can collide too."""
    m = re.match(r"^(.*?)(\d+)\.\.(\d+)$", key)
    if not m:
        return [key]
    head, lo, hi = m.group(1), int(m.group(2)), int(m.group(3))
    return ["%s%d" % (head, i) for i in range(lo, hi + 1)]


def reserved_keys():
    """{key: builtin_action} for every prefix binding herdr reserves by default.

    Returns {} when herdr cannot be run. Callers MUST treat empty as "unknown", never as
    "nothing is reserved" — silently proceeding on an unanswerable question is how the original
    collisions shipped.
    """
    h = herdr_bin()
    if not h:
        return {}
    rc, out = run([h, "--default-config"])
    if rc != 0 or not out:
        return {}
    res = {}
    for line in out.splitlines():
        s = line.strip().lstrip("#").strip()
        m = re.match(r'^([a-z_]+)\s*=\s*"(prefix\+[^"]+)"', s)
        if not m:
            continue
        action, key = m.group(1), m.group(2)
        # `prefix = "ctrl+b"` is the prefix itself; `key = "prefix+alt+g"` is the commented
        # [[keys.command]] EXAMPLE, not a reserved built-in. Neither is a binding we can break.
        if action in ("prefix", "key"):
            continue
        for k in _expand(key):
            res[k] = action
    return res


def strip_managed(text):
    """The user's config minus our own block — so we never count our bindings as conflicts."""
    return re.compile(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", re.S).sub("", text)


def keymap_conflicts(keys=None):
    """[(key, description_of_what_it_would_break)] for the bindings we intend to install.

    Accounts for the user having REMAPPED a built-in: if they set `goto = "prefix+z"` in [keys],
    then prefix+g is genuinely free and prefix+z is the one that is taken.
    """
    taken = reserved_keys()
    if not taken:
        return None                      # unknown, not clear — the caller must say so
    labels = {k: "herdr built-in `%s`" % a for k, a in taken.items()}

    text = strip_managed(open(HERDR_CFG).read()) if os.path.isfile(HERDR_CFG) else ""

    # [keys] overrides move a built-in off its default key.
    in_keys = False
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("[") and not s.startswith("[["):
            in_keys = (s == "[keys]")
            continue
        if not in_keys or s.startswith("#"):
            continue
        m = re.match(r'^([a-z_]+)\s*=\s*"([^"]*)"', s)
        if not m:
            continue
        action, key = m.group(1), m.group(2)
        for old_key, old_action in list(labels.items()):
            if old_action == "herdr built-in `%s`" % action:
                del labels[old_key]
        for k in _expand(key):
            if k:
                labels[k] = "herdr built-in `%s` (you remapped it here)" % action

    # The user's own custom commands outside our block.
    for m in re.finditer(r'^\s*key\s*=\s*"([^"]+)"', text, re.M):
        for k in _expand(m.group(1)):
            labels[k] = "your own [[keys.command]] binding"

    return [(k, labels[k]) for k, _a, _d in (keys or KEYS) if k in labels]


def nerd_font_installed():
    for d in (os.path.join(HOME, "Library", "Fonts"), "/Library/Fonts",
              os.path.join(HOME, ".local", "share", "fonts"), "/usr/share/fonts"):
        if not os.path.isdir(d):
            continue
        for root, _dirs, files in os.walk(d):
            for f in files:
                if "nerd" in f.lower() and f.lower().endswith((".ttf", ".otf")):
                    return os.path.join(root, f)
    return None


def macos_terminal_font():
    """The font Apple Terminal actually renders with, or None.

    Terminal stores it as an NSKeyedArchiver blob per profile, so it cannot be read with a plain
    `defaults read`. This matters because it is the single most common cause of "my file tree is
    full of question marks": SpiceEdit detects a Nerd Font on DISK and emits U+F07B, but the
    terminal renders tofu because its own profile font has no such glyph. Checking the installed
    font alone gives a false all-clear.
    """
    if sys.platform != "darwin":
        return None
    try:
        import plistlib
        rc, out = run(["/usr/bin/defaults", "export", "com.apple.Terminal", "-"], capture_bytes=True)
        if rc != 0 or not out:
            return None
        d = plistlib.loads(out)
        prof = d.get("Startup Window Settings") or d.get("Default Window Settings")
        cfg = (d.get("Window Settings") or {}).get(prof) or {}
        blob = cfg.get("Font")
        if not isinstance(blob, bytes):
            return None
        objs = plistlib.loads(blob).get("$objects") or []
        names = [o for o in objs if isinstance(o, str) and o not in ("$null",)]
        return (prof, names[0]) if names else None
    except Exception:
        return None


def terminal_report():
    """(is_ok, message) describing whether the RUNNING terminal can render Nerd Font glyphs."""
    prog = (os.environ.get("TERM_PROGRAM") or "").lower()
    if "ghostty" in prog or os.environ.get("GHOSTTY_RESOURCES_DIR"):
        cfg = os.path.join(HOME, ".config", "ghostty", "config")
        fam = ""
        if os.path.isfile(cfg):
            m = re.search(r'^\s*font-family\s*=\s*"?([^"\n]+)"?', open(cfg).read(), re.M)
            fam = (m.group(1).strip() if m else "")
        if fam and "nerd" in fam.lower():
            return True, "terminal is Ghostty with font-family = %s — glyphs will render" % fam
        return False, ("terminal is Ghostty but font-family is %s — set it to a Nerd Font in %s"
                       % (fam or "unset", cfg))

    info = macos_terminal_font()
    if info:
        prof, font = info
        if "nerd" in font.lower():
            return True, "Apple Terminal profile %r uses %s — glyphs will render" % (prof, font)
        return False, ("Apple Terminal profile %r uses %s, which has NO Nerd Font glyphs — the "
                       "file tree will show boxes/question marks. Either set that profile's font "
                       "to a Nerd Font (Settings > Profiles > Text > Font), or switch to a "
                       "terminal like Ghostty. Apple Terminal also supports no image protocol "
                       "and no OSC 52 clipboard, so switching gains more than icons."
                       % (prof, font))
    return False, ("could not identify the running terminal — SpiceEdit cannot detect what font "
                   "your terminal uses, so if the tree shows boxes, set its font to a Nerd Font")


def server_error(out):
    """Return a human explanation when herdr's reply is an API error rather than data.

    The CLI answers with a JSON envelope, and an unreachable/mismatched server still exits 0 with
    an {"error": ...} body. Treating that as "the plugin is missing" would be a false negative: an
    unanswerable question is not a NO. The common case is a version mismatch after `brew upgrade`
    while the old server is still running, which no amount of reinstalling can fix — only a
    server restart can, and that kills pane processes, so we must say so rather than guess.
    """
    if not out:
        return "no response from herdr"
    try:
        err = json.loads(out).get("error")
    except Exception:
        return None
    if not err:
        return None
    code = err.get("code", "error")
    if code == "protocol_mismatch":
        return ("herdr CLI is newer than the running server (%s). Restart the herdr server to "
                "continue — note that stopping it exits pane processes." % code)
    return "herdr API error: %s — %s" % (code, (err.get("message") or "").split("\n")[0])


def plugin_registered():
    """True / False / None, where None means 'could not ask the server'."""
    h = herdr_bin()
    if not h:
        return None
    rc, out = run([h, "plugin", "list"])
    if server_error(out) or rc != 0:
        return None
    return PLUGIN_ID in out


# ---------------------------------------------------------------------------------------------
# rendering
# ---------------------------------------------------------------------------------------------


def render_plugin(dry, projects_root):
    """Write the plugin manifest + launcher, substituting absolute binary paths.

    The manifest is a template precisely because pane commands must be absolute (launchd PATH) and
    the correct absolute path differs per machine: /opt/homebrew on Apple Silicon, /usr/local on
    Intel, /usr/bin on Linux.
    """
    spice = editor_bin()
    lazy = which("lazygit")
    missing = [n for n, p in (("herdr-edit or spiceedit", spice), ("lazygit", lazy)) if not p]
    if missing:
        die("cannot render plugin, missing: %s (run `herdr-extensions install` without --no-deps)"
            % ", ".join(missing))

    src_manifest = os.path.join(REPO, "plugin", "herdr-plugin.toml")
    src_launcher = os.path.join(REPO, "plugin", "open-panel.sh")
    panel_srcs = [os.path.join(REPO, "libexec", n) for n in PANEL_SCRIPTS]
    for f in [src_manifest, src_launcher] + panel_srcs:
        if not os.path.isfile(f):
            die("package file missing: %s" % f)

    manifest = open(src_manifest).read()
    manifest = manifest.replace("@@SPICEEDIT@@", spice).replace("@@LAZYGIT@@", lazy)
    launcher = open(src_launcher).read().replace("@@PROJECTS_ROOT@@", projects_root)
    # resize-pane.sh needs herdr itself by absolute path, for the same launchd-PATH reason every
    # other command here is absolute: a bare `herdr` never resolves in a plugin action.
    src_resize = os.path.join(REPO, "plugin", "resize-pane.sh")
    if not os.path.isfile(src_resize):
        die("package file missing: %s" % src_resize)
    resizer = open(src_resize).read().replace("@@HERDR@@", which("herdr") or "herdr")
    src_img = os.path.join(REPO, "plugin", "image-paste.sh")
    if not os.path.isfile(src_img):
        die("package file missing: %s" % src_img)
    imgpaste = open(src_img).read().replace("@@HERDR@@", which("herdr") or "herdr")

    if dry:
        act("would write %s (spiceedit=%s, lazygit=%s, %d panel scripts)"
            % (PLUGIN_DST, spice, lazy, len(PANEL_SCRIPTS)))
        return False

    os.makedirs(PLUGIN_DST, exist_ok=True)
    changed = False
    files = [("herdr-plugin.toml", manifest, 0o644), ("open-panel.sh", launcher, 0o755),
             ("resize-pane.sh", resizer, 0o755),
             ("image-paste.sh", imgpaste, 0o755)]
    # Panel scripts are copied verbatim EXCEPT for the same absolute-path templating the manifest
    # gets: the preview panel shells out to chafa and Chrome, and under launchd's PATH neither a bare
    # `chafa` nor a bare `chrome` resolves. Substitution is applied to every panel so there is one
    # rule rather than a special case.
    chafa = which("chafa") or "chafa"
    chrome = next((c for c in (
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "/Applications/Chromium.app/Contents/MacOS/Chromium",
        which("google-chrome") or "", which("chromium") or "",
    ) if c and os.path.exists(c)), "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
    files += [(n, open(p).read().replace("@@CHAFA@@", chafa).replace("@@CHROME@@", chrome), 0o755)
              for n, p in zip(PANEL_SCRIPTS, panel_srcs)]
    for name, body, mode in files:
        dst = os.path.join(PLUGIN_DST, name)
        old = open(dst).read() if os.path.isfile(dst) else None
        if old != body:
            with open(dst, "w") as fh:
                fh.write(body)
            changed = True
        os.chmod(dst, mode)
    act("plugin files %s" % ("updated" if changed else "already current"))
    return changed


def write_json(path, data, dry):
    """Write a JSON config, reporting whether it changed. No comment keys: SpiceEdit parses with
    disallowUnknownFields, so one stray key rejects the whole file."""
    body = json.dumps(data, indent=2) + "\n"
    old = open(path).read() if os.path.isfile(path) else None
    if old == body:
        return False
    if dry:
        act("would write %s" % path)
        return True
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        fh.write(body)
    return True


def spice_configs(dry):
    fmt = os.path.join(BIN_DIR, "herdr-fmt")
    exts = ["js", "jsx", "ts", "tsx", "mjs", "cjs", "json", "jsonc", "css", "scss", "less",
            "html", "md", "mdx", "yaml", "yml", "graphql", "vue"]
    changed = False
    changed |= write_json(os.path.join(SPICE_CFG_DIR, "config.json"), {"icons": "auto"}, dry)
    changed |= write_json(os.path.join(SPICE_CFG_DIR, "format-defaults.json"),
                          {"commands": {e: [fmt, "$FILE"] for e in exts}}, dry)
    actions = {"actions": [
        {"label": "Reveal in Finder", "command": '/usr/bin/open -R "$FILE"'},
    ]}
    editor = which("code")
    if editor:
        actions["actions"].append({"label": "Open in VS Code",
                                   "command": '%s "$FILE"' % editor})
    changed |= write_json(os.path.join(SPICE_CFG_DIR, "actions.json"), actions, dry)
    act("SpiceEdit configs %s" % ("written" if changed else "already current"))
    return changed


def install_fmt(dry):
    src = os.path.join(REPO, "libexec", "herdr-fmt")
    if not os.path.isfile(src):
        die("package file missing: %s" % src)
    dst = os.path.join(BIN_DIR, "herdr-fmt")
    body = open(src).read()
    old = open(dst).read() if os.path.isfile(dst) else None
    if old == body:
        act("herdr-fmt already current")
        return False
    if dry:
        act("would install %s" % dst)
        return True
    os.makedirs(BIN_DIR, exist_ok=True)
    with open(dst, "w") as fh:
        fh.write(body)
    os.chmod(dst, 0o755)
    act("installed %s" % dst)
    return True


def key_block():
    h = herdr_bin() or "herdr"
    lines = [BEGIN,
             "# Managed by herdr-extensions. Edit above/below this block, not inside it —",
             "# `herdr-extensions uninstall` removes exactly these lines and nothing else.",
             "# The herdr path is absolute because the server execs this under launchd's PATH."]
    for key, action, desc in KEYS:
        lines += ["",
                  "# %s -> %s" % (key, desc),
                  "[[keys.command]]",
                  'key = "%s"' % key,
                  'type = "shell"',
                  'command = "%s plugin action invoke %s --plugin %s"' % (h, action, PLUGIN_ID)]
    lines.append(END)
    return "\n".join(lines) + "\n"


def inject_keys(dry):
    """Insert or refresh the managed keybinding block, leaving everything else byte-identical."""
    block = key_block()
    old = open(HERDR_CFG).read() if os.path.isfile(HERDR_CFG) else ""
    pat = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", re.S)
    # Normalize the separator so install/uninstall/install is byte-stable. Appending "\n" + block
    # onto a file whose trailing newlines vary drifts by one blank line per cycle.
    if pat.search(old):
        new = pat.sub(block, old)
    else:
        base = old.rstrip("\n")
        new = (base + "\n\n" + block) if base else block
    if new == old:
        act("keybindings already current")
        return False
    if dry:
        act("would %s the managed keybinding block in %s"
            % ("refresh" if pat.search(old) else "append", HERDR_CFG))
        return True
    os.makedirs(HERDR_CFG_DIR, exist_ok=True)
    with open(HERDR_CFG, "w") as fh:
        fh.write(new)
    act("keybindings written (%s)" % ", ".join(k for k, _a, _d in KEYS))
    return True


# ---------------------------------------------------------------------------------------------
# lazygit AI-commit custom command
#
# lazygit runs as a plugin pane too (the "git" [[panes]] entry above), so a customCommand it
# invokes is exec'd by the herdr server under launchd's PATH exactly like every panel/action in
# this package -- a bare `claude` would silently never resolve. Same fix as everywhere else: an
# absolute path baked in at install time, spliced in as its own marker-delimited region so
# `uninstall` removes exactly it and nothing the user added themselves.
# ---------------------------------------------------------------------------------------------

LAZYGIT_BEGIN = "# >>> herdr-extensions lazygit (managed) >>>"
LAZYGIT_END = "# <<< herdr-extensions lazygit (managed) <<<"


def lazygit_config_path():
    """Where lazygit reads its own config.yml, per lazygit's own docs."""
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        return os.path.join(xdg, "lazygit", "config.yml")
    if sys.platform == "darwin":
        return os.path.join(HOME, "Library", "Application Support", "lazygit", "config.yml")
    return os.path.join(HOME, ".config", "lazygit", "config.yml")


def lazygit_ai_commit_block(claude_bin):
    """The managed customCommands fragment, marker-delimited like every other splice here.

    🔴 This is a root-level `customCommands:` key appended at the end of the file. If the user's
    OWN config.yml already declares a top-level customCommands: list somewhere else, YAML keeps
    only the LAST mapping for a duplicate key, so this block wins and theirs is shadowed rather
    than merged -- the same trade-off apply_skin() documents for the [ui] table, and for the same
    reason: a real YAML parser is out of scope (stdlib-only Python 3.9, no pyyaml).
    """
    cmd = ('git commit -e -m "$(git diff --cached | "%s" -p '
           '"Write a single-line, imperative git commit subject (max 72 characters, no trailing '
           'period) that summarizes this staged diff. Output ONLY the subject line, '
           'nothing else.")"' % claude_bin)
    lines = [
        LAZYGIT_BEGIN,
        "# Managed by herdr-extensions. Edit above/below this block, not inside it --",
        "# `herdr-extensions uninstall` removes exactly these lines and nothing else.",
        "# NOTE: if you already have your own top-level customCommands: list elsewhere in this",
        "# file, YAML keeps only the LAST one and this block wins -- fold your entries into this",
        "# one instead of relying on both being merged.",
        "customCommands:",
        "  - key: '<c-a>'",
        "    context: files",
        "    description: 'AI: draft commit message from the staged diff'",
        "    loadingText: 'Asking claude for a commit message...'",
        "    command: '%s'" % cmd.replace("'", "''"),
        LAZYGIT_END,
    ]
    return "\n".join(lines) + "\n"


def write_lazygit_ai_commit(dry):
    """Splice a lazygit customCommand that drafts a commit subject from the staged diff.

    Additive, not required: if `claude` is not on this machine, warn and skip rather than fail the
    whole install over one optional step.
    """
    claude_bin = which("claude")
    if not claude_bin:
        warn("`claude` CLI not found -- skipping the lazygit AI-commit command "
             "(install it and re-run to add it)")
        return False
    path = lazygit_config_path()
    block = lazygit_ai_commit_block(claude_bin)
    old = open(path).read() if os.path.isfile(path) else ""
    pat = re.compile(re.escape(LAZYGIT_BEGIN) + r".*?" + re.escape(LAZYGIT_END) + r"\n?", re.S)
    if pat.search(old):
        new = pat.sub(block, old)
    else:
        base = old.rstrip("\n")
        new = (base + "\n\n" + block) if base else block
    if new == old:
        act("lazygit AI-commit command already current")
        return False
    if dry:
        act("would %s the lazygit AI-commit command in %s"
            % ("refresh" if pat.search(old) else "append", path))
        return True
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        fh.write(new)
    act("lazygit AI-commit command written (%s)" % path)
    return True


# ---------------------------------------------------------------------------------------------
# skins
#
# 🔴 WHY THIS IS TWO SPLICED BLOCKS, NOT ONE. The user's config.toml already has a bare [theme]
# table (name/auto_switch) and a bare [ui] table (agent_panel_sort/...) OUTSIDE our markers. TOML
# table headers are root-anchored regardless of where they appear, so a fresh, never-before-used
# [theme.custom] header is safe to append anywhere — verified with tomllib. But [ui] is already
# DECLARED, and TOML forbids declaring the same table twice via a header ("Cannot declare ('ui',)
# twice"); a bare dotted key like `ui.accent = ...` written after ANY other header in the file does
# NOT reach the root ui table either — dotted keys are relative to whichever table the most recent
# header opened, so it silently nests inside whatever came right before it (verified: it landed
# inside the last [[keys.command]] entry). The only place new `ui` keys can legally land is inside
# the user's own existing [ui] body, before its next header — so that fragment is spliced in place,
# immediately after the "[ui]" line, under its OWN marker pair, while [theme.custom] and everything
# else stays in the normal end-of-file managed block.
# ---------------------------------------------------------------------------------------------


def skin_names():
    d = os.path.join(REPO, "skins")
    return sorted(os.path.splitext(os.path.basename(p))[0] for p in glob.glob(os.path.join(d, "*.toml")))


def load_skin_sections(name):
    """[theme.custom] and [ui] key=value lines from skins/<name>.toml.

    Skin files are themselves complete, valid TOML (so they can be checked on their own with
    `python3 -c "import tomllib; tomllib.load(...)"`), but the installer only needs the raw lines
    under each section — it never parses TOML generally, matching the Python 3.9 / no-tomllib
    constraint that applies everywhere else in this file.
    """
    path = os.path.join(REPO, "skins", "%s.toml" % name)
    if not os.path.isfile(path):
        die("unknown skin %r — available: %s" % (name, ", ".join(skin_names()) or "(none bundled)"))
    theme_lines, ui_lines, cur = [], [], None
    for raw in open(path).read().splitlines():
        s = raw.strip()
        if s == "[theme.custom]":
            cur = "theme"
            continue
        if s == "[ui]":
            cur = "ui"
            continue
        if s.startswith("["):
            cur = None
            continue
        if not s or s.startswith("#"):
            continue
        if cur == "theme":
            theme_lines.append(raw)
        elif cur == "ui":
            ui_lines.append(raw)
    return theme_lines, ui_lines


def _strip_skin_blocks(text):
    text = re.sub(re.escape(SKIN_BEGIN) + r".*?" + re.escape(SKIN_END) + r"\n?", "", text, flags=re.S)
    text = re.sub(re.escape(SKIN_UI_BEGIN) + r".*?" + re.escape(SKIN_UI_END) + r"\n?", "", text, flags=re.S)
    return text


def apply_skin(name, dry):
    """Write (or refresh) the managed skin blocks. Idempotent: reapplying the same skin twice, or
    switching from one skin to another, always starts from a clean baseline (skin blocks stripped
    first) so no stale fragment is ever left behind."""
    theme_lines, ui_lines = load_skin_sections(name)
    old = open(HERDR_CFG).read() if os.path.isfile(HERDR_CFG) else ""
    clean = _strip_skin_blocks(old)

    ui_block = "\n".join([SKIN_UI_BEGIN,
                          "# Managed by herdr-extensions (applied by `herdr-extensions skin %s`)." % name,
                          "# `herdr-extensions skin reset` removes this along with the block below."]
                         + ui_lines + [SKIN_UI_END]) + "\n"

    m = re.search(r"(?m)^\[ui\][ \t]*$", clean)
    if m:
        nl = clean.find("\n", m.end())
        at = nl + 1 if nl != -1 else len(clean)
        clean = clean[:at] + ui_block + clean[at:]
        ui_spliced = True
    else:
        ui_spliced = False

    lines = [SKIN_BEGIN,
             "# Managed by herdr-extensions. Edit above/below this block, not inside it —",
             "# `herdr-extensions skin reset` removes exactly these lines (and, if present, the",
             "# spliced-in ui block just inside your own [ui] section).",
             "# Applied with: herdr-extensions skin %s" % name,
             "",
             "[theme.custom]"] + theme_lines
    if not ui_spliced:
        lines += ["", "[ui]"] + ui_lines
    lines.append(SKIN_END)
    block = "\n".join(lines) + "\n"

    base = clean.rstrip("\n")
    new = (base + "\n\n" + block) if base else block

    if new == old:
        act("skin '%s' already applied" % name)
        return False
    if dry:
        act("would apply skin '%s' to %s" % (name, HERDR_CFG))
        return True
    os.makedirs(HERDR_CFG_DIR, exist_ok=True)
    with open(HERDR_CFG, "w") as fh:
        fh.write(new)
    act("skin '%s' written to %s" % (name, HERDR_CFG))
    return True


def reset_skin(dry):
    """Remove every managed skin block, restoring the file to what it was before any skin was
    ever applied — byte-for-byte, mirroring how inject_keys/cmd_uninstall round-trip the
    keybinding block."""
    if not os.path.isfile(HERDR_CFG):
        act("no config file — nothing to reset")
        return False
    old = open(HERDR_CFG).read()
    new = _strip_skin_blocks(old)
    new = re.sub(r"\n{3,}", "\n\n", new).rstrip("\n") + "\n" if new.strip() else new
    if new == old:
        act("no skin applied — nothing to reset")
        return False
    if dry:
        act("would remove the applied skin from %s" % HERDR_CFG)
        return True
    with open(HERDR_CFG, "w") as fh:
        fh.write(new)
    act("skin reset — removed the managed skin block(s)")
    return True


def reload_config_best_effort():
    """Ask the running herdr server to pick up the config change. Never `server stop` — that kills
    every live pane including the user's agents. The CLI can be protocol-mismatched with an
    already-running server (e.g. right after `brew upgrade`), so a failed reload is expected and
    handled, not fatal: report it and tell the user the one command that fixes it."""
    h = herdr_bin()
    if not h:
        warn("herdr not found on PATH — once it is, run `herdr server reload-config` yourself")
        return
    rc, out = run([h, "server", "reload-config"])
    problem = server_error(out) if rc == 0 else "herdr did not respond"
    if rc == 0 and not problem:
        ok("herdr config reloaded")
    else:
        warn("could not reload herdr automatically (%s)" % (problem or "unknown error"))
        print("        Run `herdr server reload-config` yourself once the server is reachable.")


# ---------------------------------------------------------------------------------------------
# dependencies
# ---------------------------------------------------------------------------------------------


def install_deps(dry):
    brew = which("brew")
    steps = []
    if not editor_bin():
        # 🔴 The tap must be the repo that CONTAINS the formula. This tapped
        # cloudmanic/spice-edit (upstream, which ships spice-edit.rb only) while installing from
        # vonzelle-vzt/herdr-edit — a tap that was therefore never added, so a fresh install died
        # with "No available formula or cask ... This command requires the tap vonzelle-vzt/herdr-edit".
        # Anyone who already had the editor never saw it, because this whole branch is skipped then.
        steps.append(("herdr-edit", ["brew", "install", "vonzelle-vzt/herdr-edit/herdr-edit"],
                      ["brew", "tap", "vonzelle-vzt/herdr-edit",
                       "https://github.com/vonzelle-vzt/herdr-edit"]))
    if not which("lazygit"):
        steps.append(("lazygit", ["brew", "install", "lazygit"], None))
    if not nerd_font_installed():
        steps.append(("nerd font", ["brew", "install", "--cask",
                                    "font-jetbrains-mono-nerd-font"], None))
    if not steps and prettier_available():
        ok("all dependencies present")
        return
    if not brew and steps:
        for name, _c, _t in steps:
            warn("%s missing and Homebrew not found — install it manually" % name)
        return
    for name, cmd, tap in steps:
        if dry:
            act("would install %s" % name)
            continue
        act("installing %s ..." % name)
        if tap:
            run(tap)
        rc, out = run(cmd)
        if which(name.split()[0]) or rc == 0:
            ok("%s installed" % name)
        else:
            bad("%s failed:\n%s" % (name, out.strip()[-400:]))
    if not prettier_available():
        if dry:
            act("would install prettier globally (npm i -g prettier)")
        elif which("npm"):
            act("installing prettier ...")
            run([which("npm"), "i", "-g", "prettier"])
            ok("prettier installed") if prettier_available() else warn("prettier install failed")
        else:
            warn("npm not found — format-on-save will only work in repos that vendor prettier")



def editor_staleness():
    """Warn when the editor on PATH is older than the release the tap offers.

    A hand-built editor goes stale silently. Building from source puts a binary on PATH that never
    changes again, while merging the fork's main auto-tags a release -- so the two drift apart with
    nothing to say so, and a bug you already fixed keeps reproducing. Observed for real: a locally
    built 0.5.0 while the tap had moved to 0.5.4.

    Deliberately OFFLINE: it reads the version out of the tapped formula on disk rather than asking
    GitHub, so `doctor` stays fast and works on a plane. No tap, no check -- silence beats a
    network-dependent warning that sometimes appears.
    """
    ed = which(EDITOR_CANDIDATES[0])
    if not ed:
        return
    rc, out = run([ed, "--version"])
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", out or "")
    if rc != 0 or not m:
        return
    have = tuple(int(g) for g in m.groups())

    # The formula lives in the tap Homebrew cloned for us; `brew --repo <tap>` names it without
    # needing brew to resolve anything.
    brew = which("brew")
    if not brew:
        return
    rc, repo = run([brew, "--repo", "vonzelle-vzt/herdr-edit"])
    formula = os.path.join((repo or "").strip(), "Formula", "herdr-edit.rb")
    if rc != 0 or not os.path.isfile(formula):
        return
    try:
        body = open(formula).read()
    except OSError:
        return
    m = re.search(r'/v(\d+)\.(\d+)\.(\d+)\.tar\.gz', body) or \
        re.search(r'version\s+"(\d+)\.(\d+)\.(\d+)"', body)
    if not m:
        return
    avail = tuple(int(g) for g in m.groups())

    hv, av = ".".join(map(str, have)), ".".join(map(str, avail))
    if have < avail:
        warn("herdr-edit %s is older than %s in the tap — rebuild (`make build` in a checkout, or "
             "`brew upgrade herdr-edit`). A source build never updates itself." % (hv, av))
    else:
        ok("herdr-edit %s is current (tap offers %s)" % (hv, av))

def prettier_available():
    if which("prettier"):
        return True
    return bool(glob.glob(os.path.join(HOME, ".nvm", "versions", "node", "*", "bin", "prettier")))


# ---------------------------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------------------------


def cmd_install(args):
    head("herdr-extensions install%s" % (" (dry run — nothing will change)" if args.dry_run else ""))
    v = herdr_version()
    if not herdr_bin():
        die("herdr is not installed — see https://herdr.dev")
    if v and v < (0, 7, 0):
        die("herdr %s is too old; plugins need >= 0.7.0" % ".".join(map(str, v)))
    ok("herdr %s" % (".".join(map(str, v)) if v else "(version unknown)"))

    # Fail fast if the server cannot answer: `plugin link` and `server reload-config` would both be
    # no-ops, leaving configs written but nothing actually registered — a confusing half-state.
    _rc, probe = run([herdr_bin(), "plugin", "list"])
    problem = server_error(probe)
    if problem and not args.dry_run:
        die("%s\n       Nothing was changed. Re-run this after the restart." % problem)

    # Refuse rather than silently steal a key. A [[keys.command]] entry overrides a herdr built-in
    # with no warning anywhere, so a collision looks to the user like herdr itself broke. Checked
    # BEFORE anything is written, so a refusal leaves the machine untouched.
    head("Keymap")
    conflicts = keymap_conflicts()
    if conflicts is None:
        warn("could not read herdr's default keymap — skipping the collision check")
    elif conflicts:
        for key, what in conflicts:
            bad("%s would override %s" % (key, what))
        if not args.force:
            die("Refusing to install: the bindings above are already in use.\n"
                "       Nothing was changed. Re-run with --force to override them anyway,\n"
                "       or free the keys first. `herdr-extensions doctor --keymap` explains more.")
        warn("--force: overriding %d existing binding(s) anyway" % len(conflicts))
    else:
        ok("no keybinding collisions (%d herdr built-ins checked)" % len(reserved_keys()))

    if not args.no_deps:
        head("Dependencies")
        install_deps(args.dry_run)

    head("Plugin")
    render_plugin(args.dry_run, args.projects_root)
    if not args.dry_run:
        rc, out = run([herdr_bin(), "plugin", "link", PLUGIN_DST])
        ok("plugin linked") if rc == 0 else bad("plugin link failed: %s" % out.strip()[-300:])

    head("Editor configuration")
    install_fmt(args.dry_run)
    spice_configs(args.dry_run)

    head("Keybindings")
    inject_keys(args.dry_run)

    head("lazygit AI commit")
    write_lazygit_ai_commit(args.dry_run)

    if args.skin:
        head("Skin")
        if args.skin not in skin_names():
            die("unknown skin %r — available: %s" % (args.skin, ", ".join(skin_names()) or "(none bundled)"))
        apply_skin(args.skin, args.dry_run)

    if not args.dry_run:
        reload_config_best_effort()

    if args.dry_run:
        return 0
    head("Done")
    for key, _a, desc in KEYS:
        print("  %-16s %s" % (key.replace("prefix", "ctrl+b"), desc))
    print("\n  Run `herdr-extensions doctor` to verify, and note that FILE ICONS need your")
    print("  terminal's font set to a Nerd Font — doctor explains it.")
    return 0


def cmd_uninstall(args):
    head("herdr-extensions uninstall")
    if plugin_registered():
        rc, out = run([herdr_bin(), "plugin", "uninstall", PLUGIN_ID])
        ok("plugin unregistered") if rc == 0 else warn("could not unregister: %s" % out.strip()[-200:])
    else:
        ok("plugin was not registered")

    if os.path.isfile(HERDR_CFG):
        old = open(HERDR_CFG).read()
        new = re.sub(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", "", old, flags=re.S)
        # Collapse the gap the block leaves behind and normalize to exactly one trailing newline,
        # mirroring inject_keys, so install/uninstall/install is byte-identical (SPEC oracle 2).
        new = re.sub(r"\n{3,}", "\n\n", new).rstrip("\n") + "\n"
        if new != old:
            with open(HERDR_CFG, "w") as fh:
                fh.write(new)
            ok("removed managed keybindings (your own settings untouched)")
        else:
            ok("no managed keybindings present")

    lg_path = lazygit_config_path()
    if os.path.isfile(lg_path):
        old = open(lg_path).read()
        new = re.sub(re.escape(LAZYGIT_BEGIN) + r".*?" + re.escape(LAZYGIT_END) + r"\n?", "", old, flags=re.S)
        new = re.sub(r"\n{3,}", "\n\n", new).rstrip("\n") + "\n"
        if new != old:
            with open(lg_path, "w") as fh:
                fh.write(new)
            ok("removed the lazygit AI-commit command (your own lazygit config untouched)")
        else:
            ok("no managed lazygit command present")

    if os.path.isdir(PLUGIN_DST):
        shutil.rmtree(PLUGIN_DST)
        ok("removed %s" % PLUGIN_DST)

    if args.purge:
        for f in ("config.json", "format-defaults.json", "actions.json"):
            p = os.path.join(SPICE_CFG_DIR, f)
            if os.path.isfile(p):
                os.remove(p)
                ok("removed %s" % p)
        fmt = os.path.join(BIN_DIR, "herdr-fmt")
        if os.path.isfile(fmt):
            os.remove(fmt)
            ok("removed %s" % fmt)
    else:
        print("\n  SpiceEdit configs and herdr-fmt were kept. Use --purge to remove them.")

    if herdr_bin():
        run([herdr_bin(), "server", "reload-config"])
    return 0


def cmd_doctor(_args=None):
    head("herdr-extensions doctor")
    fails = 0
    audit_all = getattr(_args, "keymap", False)

    v = herdr_version()
    if not herdr_bin():
        bad("herdr not installed")
        fails += 1
    elif v and v < (0, 7, 0):
        bad("herdr %s < 0.7.0 (plugins unsupported)" % ".".join(map(str, v)))
        fails += 1
    else:
        ok("herdr %s at %s" % (".".join(map(str, v)) if v else "?", herdr_bin()))

    head("Binaries (must be absolute — the herdr server runs under launchd's minimal PATH)")
    for name in (EDITOR_CANDIDATES[0] if editor_is_fork() else EDITOR_CANDIDATES[1], "lazygit"):
        p = which(name)
        if p:
            ok("%-10s %s" % (name, p))
        else:
            bad("%-10s not found" % name)
            fails += 1
    editor_staleness()

    head("Plugin")
    reg = plugin_registered()
    if reg is True:
        ok("plugin '%s' registered with herdr" % PLUGIN_ID)
    elif reg is None:
        # Distinguish "cannot ask" from "answered no" — reinstalling cannot fix an unreachable
        # server, so telling the user to reinstall here would send them down the wrong path.
        _rc, out = run([herdr_bin(), "plugin", "list"]) if herdr_bin() else (1, "")
        bad("cannot verify: %s" % (server_error(out) or "herdr did not answer"))
        fails += 1
    else:
        bad("plugin '%s' not registered — run `herdr-extensions install`" % PLUGIN_ID)
        fails += 1
    manifest = os.path.join(PLUGIN_DST, "herdr-plugin.toml")
    if os.path.isfile(manifest):
        # Ignore comments. The template documents its own @@-substitution in a comment, so a plain
        # `"@@" in body` reported a correctly-rendered manifest as broken — a false FAIL that sends
        # the user chasing a problem that does not exist, which is worse than no check at all.
        # (Python 3.9 has no tomllib, hence line filtering rather than a real parse.)
        live = [ln for ln in open(manifest).read().splitlines()
                if not ln.lstrip().startswith("#")]
        stale = [ln.strip() for ln in live if "@@" in ln]
        if stale:
            bad("manifest still has unrendered placeholders: %s" % stale[0][:70])
            fails += 1
        else:
            ok("manifest rendered with absolute paths")
    else:
        bad("manifest missing at %s" % manifest)
        fails += 1

    head("Keybindings")
    cfg = open(HERDR_CFG).read() if os.path.isfile(HERDR_CFG) else ""
    if BEGIN in cfg and END in cfg:
        ok("managed block present (%s)" % ", ".join(k for k, _a, _d in KEYS))
    else:
        bad("managed keybinding block missing from %s" % HERDR_CFG)
        fails += 1

    head("Editor configuration")
    for f in ("config.json", "format-defaults.json", "actions.json"):
        p = os.path.join(SPICE_CFG_DIR, f)
        if not os.path.isfile(p):
            warn("%s not written" % p)
            continue
        try:
            data = json.load(open(p))
        except Exception as e:
            bad("%s is not valid JSON: %s" % (f, e))
            fails += 1
            continue
        # SpiceEdit rejects unknown top-level keys outright — catch a stray comment key here
        # rather than letting the editor silently ignore the whole file.
        allowed = {"config.json": {"icons"}, "format-defaults.json": {"commands"},
                   "actions.json": {"actions"}}[f]
        extra = set(data) - allowed
        if extra:
            bad("%s has keys SpiceEdit will reject (disallowUnknownFields): %s"
                % (f, ", ".join(sorted(extra))))
            fails += 1
        else:
            ok("%s valid" % f)

    fmt = os.path.join(BIN_DIR, "herdr-fmt")
    if os.access(fmt, os.X_OK):
        ok("herdr-fmt installed")
    else:
        warn("herdr-fmt missing — format-on-save will no-op")
    if prettier_available():
        ok("prettier reachable (global or vendored)")
    else:
        warn("no global prettier — only repos vendoring it will format")

    head("Image paste")
    # pngpaste is the only way to get an image OFF the macOS clipboard from a script. Without it
    # ctrl+b i still works from the screenshot fallback, so the failure is partial and silent --
    # exactly the kind this tool exists to name out loud.
    if which("pngpaste"):
        ok("pngpaste installed — clipboard images can be pasted")
    elif sys.platform == "darwin":
        warn("pngpaste missing — ctrl+b i will fall back to the newest screenshot and cannot read "
             "the clipboard (brew install pngpaste)")
    else:
        # Linux: pngpaste is macOS-only, so its absence is not a fault there.
        ok("clipboard images need pngpaste (macOS); the screenshot fallback works without it")
    shots = os.path.expanduser("~/.vzt/shots")
    if os.path.isdir(shots):
        n = len([f for f in os.listdir(shots) if f.startswith("clip-")])
        if n > 200:
            warn("%d staged shots in ~/.vzt/shots — run `ctrl+b i` prune or "
                 "`image-paste.sh --prune`" % n)
        else:
            ok("%d staged shot(s) in ~/.vzt/shots" % n)

    head("Keymap")
    reserved = reserved_keys()
    if not reserved:
        warn("could not read herdr's default keymap — collision check skipped")
    else:
        ours = keymap_conflicts() or []
        if ours:
            for key, what in ours:
                bad("%s (ours) overrides %s" % (key, what))
            fails += len(ours)
        else:
            ok("our %d binding(s) collide with none of herdr's %d built-ins"
               % (len(KEYS), len(reserved)))

        # A [[keys.command]] entry silently wins over a built-in, so the user's OWN bindings can
        # break herdr just as easily as ours can. Worth reporting even though it is not our doing.
        text = strip_managed(open(HERDR_CFG).read()) if os.path.isfile(HERDR_CFG) else ""
        theirs = []
        for m in re.finditer(r'^\s*key\s*=\s*"([^"]+)"', text, re.M):
            for k in _expand(m.group(1)):
                if k in reserved:
                    theirs.append((k, reserved[k]))
        if theirs:
            for key, action in theirs:
                warn("%s (your own binding) overrides herdr built-in `%s`" % (key, action))
        elif audit_all:
            ok("your own bindings collide with nothing either")

        if audit_all:
            print()
            act("herdr reserves %d prefix bindings:" % len(reserved))
            for k in sorted(reserved):
                print("      %-18s %s" % (k, reserved[k]))

    head("Icons")
    font = nerd_font_installed()
    if font:
        ok("Nerd Font present: %s" % os.path.basename(font))
        term = terminal_report()
        (ok if term[0] else warn)(term[1])
    else:
        warn("no Nerd Font installed — file-type icons will stay off")

    print()
    if fails:
        bad("%d problem(s) found" % fails)
        return 1
    ok("all checks passed")
    return 0


def cmd_skin(args):
    names = skin_names()
    if args.name in (None, "list"):
        head("herdr-extensions skin list")
        if not names:
            warn("no skins bundled in %s" % os.path.join(REPO, "skins"))
        else:
            for n in names:
                print("  %s" % n)
            print("\n  Apply with `herdr-extensions skin <name>`; undo with `herdr-extensions skin reset`.")
        return 0

    if args.name == "reset":
        head("herdr-extensions skin reset%s" % (" (dry run)" if args.dry_run else ""))
        changed = reset_skin(args.dry_run)
        if changed and not args.dry_run:
            reload_config_best_effort()
        return 0

    if args.name not in names:
        die("unknown skin %r — available: %s" % (args.name, ", ".join(names) or "(none bundled)"))

    head("herdr-extensions skin %s%s" % (args.name, " (dry run)" if args.dry_run else ""))
    changed = apply_skin(args.name, args.dry_run)
    if changed and not args.dry_run:
        reload_config_best_effort()
        print("\n  Run `herdr-extensions skin reset` to go back to your previous colors.")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="herdr-extensions", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("install", help="install and configure everything (idempotent)")
    p.add_argument("--dry-run", action="store_true", help="print the plan, change nothing")
    p.add_argument("--no-deps", action="store_true", help="skip installing dependencies")
    p.add_argument("--projects-root", default=os.path.join(HOME, "github-projects"),
                   help="where the editor opens when you are not inside a git repo")
    p.add_argument("--force", action="store_true",
                   help="install even if our keybindings would override herdr built-ins")
    p.add_argument("--skin", default=None,
                   help="also apply a color skin (see `herdr-extensions skin list`); "
                        "kept out of install unless passed")
    p.set_defaults(fn=cmd_install)

    p = sub.add_parser("skin", help="apply or reset a bundled herdr color skin")
    p.add_argument("name", nargs="?", default="list",
                   help="skin name (see 'list'), or 'reset' to restore your previous colors")
    p.add_argument("--dry-run", action="store_true", help="print the plan, change nothing")
    p.set_defaults(fn=cmd_skin)

    p = sub.add_parser("uninstall", help="remove the plugin and managed keybindings")
    p.add_argument("--purge", action="store_true", help="also remove SpiceEdit configs")
    p.set_defaults(fn=cmd_uninstall)

    p = sub.add_parser("doctor", help="diagnose the setup")
    p.add_argument("--keymap", action="store_true",
                   help="audit EVERY binding in your config against herdr's built-ins, not just ours")
    p.set_defaults(fn=cmd_doctor)
    sub.add_parser("version", help="print version").set_defaults(
        fn=lambda _a: (print("herdr-extensions %s" % VERSION), 0)[1])

    args = ap.parse_args()
    if not getattr(args, "fn", None):
        ap.print_help()
        return 0
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main() or 0)
